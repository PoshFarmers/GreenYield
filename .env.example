SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
POWERSYNC_URL=

# Snap-to-List: gemini (real, falls back to a sample suggestion on any
# failure) or mock (never calls the network). NOT a secret — the Gemini
# key lives only in Supabase: supabase secrets set GEMINI_API_KEY=...
AI_ASSISTANT_MODE=gemini

# Weather-Smart Driver Tips: mock (sample forecast, no network) — the
# only option until the real Open-Meteo + Gemini version is built.
DRIVER_TIPS_MODE=mock
